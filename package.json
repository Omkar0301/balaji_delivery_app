{
  "name": "balaji-fresh-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel ngrok",
    "web": "expo start --web",
    "preview": "python scratch/spa_server.py",
    "build:web": "expo export -p web --output-dir dist_web_prod",
    "build:apk": "cmd /c build-apk.bat",
    "build:apk:universal": "cmd /c build-apk.bat universal",
    "build:aab": "cmd /c build-apk.bat aab",
    "build:clean": "cmd /c \"cd /d android && gradlew.bat clean\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.5",
    "lottie-react-native": "~7.5.0",
    "lottie-web": "^5.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
